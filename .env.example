# Database
POSTGRES_DB=compass
POSTGRES_USER=compass
POSTGRES_PASSWORD=compasslocal

# Backend
SPRING_PROFILES_ACTIVE=local
COMPASS_SEED_ENABLED=true
COMPASS_CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001

# Frontend (Vite requires VITE_ prefix for client-exposed env vars)
VITE_API_BASE_URL=

# LLM — OpenAI primary, Anthropic fallback. Default model: gpt-4.1-nano.
# If OPENAI_API_KEY is set, uses OpenAI. Otherwise falls back to ANTHROPIC_API_KEY.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
LLM_MODEL=gpt-4.1-nano
LLM_BASE_URL=https://api.openai.com/v1
